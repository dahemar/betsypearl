---
import Base from '../layouts/Base.astro';
import { VISUAL_JOURNAL_LAYOUT } from '../data/layout';
import { getSiteData } from '../lib/cms/getSite';

const { visualImages } = await getSiteData(Astro.locals);

const mobileAspect: Record<string, string> = {
  landscape: '16 / 9',
  portrait: '3 / 4',
  square: '1 / 1',
};
---

<Base title="Visuals - betsy pearl">
  <section class="visuals-journal" aria-label="Visuals gallery">
    {visualImages.map((src, i) => {
      const slot = VISUAL_JOURNAL_LAYOUT[i] ?? VISUAL_JOURNAL_LAYOUT[VISUAL_JOURNAL_LAYOUT.length - 1];
      return (
        <div
          class={`visuals-item ${slot.size} ${slot.orient} ${slot.align}`}
          style={`--ar:${mobileAspect[slot.orient]};`}
        >
          <div class="visuals-item-image">
            <img
              src={src}
              alt={`visual ${i + 1}`}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        </div>
      );
    })}
  </section>
</Base>
