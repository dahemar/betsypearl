---
import Base from '../layouts/Base.astro';
import { VISUAL_JOURNAL_LAYOUT } from '../data/layout';
import { getSiteData } from '../lib/cms/getSite';

const { visualImages } = await getSiteData(Astro.locals);

const total = visualImages.length;

const mobileAspect: Record<string, string> = {
  landscape: '16 / 9',
  portrait: '3 / 4',
  square: '1 / 1',
};
---

<Base title="Visuals - betsy pearl">
  <section class="visuals-page" aria-label="Visuals gallery">
    <div class="visuals-grid">
      {visualImages.map((src, i) => {
        const slot = VISUAL_JOURNAL_LAYOUT[i % VISUAL_JOURNAL_LAYOUT.length];
        return (
          <figure
            class={`visuals-item slot-${(i % VISUAL_JOURNAL_LAYOUT.length) + 1} ${slot.orient}`}
            style={`--ar:${mobileAspect[slot.orient]};`}
          >
            <button
              class="visuals-item-image"
              type="button"
              data-lightbox-open={i}
              aria-label={`open visual ${i + 1} of ${total}`}
            >
              <img
                src={src}
                alt={`visual ${i + 1}`}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </button>
          </figure>
        );
      })}
    </div>

    <div class="visuals-lightbox" role="dialog" aria-modal="true" aria-label="Visual viewer" hidden>
      <button class="visuals-lightbox-backdrop" type="button" data-lightbox-close aria-label="close viewer"></button>
      <figure class="visuals-lightbox-figure">
        <img class="visuals-lightbox-img" src="" alt="" />
        <figcaption class="visuals-lightbox-caption">
          <span class="visuals-lightbox-counter"></span>
          <span class="visuals-lightbox-note">visual journal</span>
        </figcaption>
      </figure>
      <button class="visuals-lightbox-nav visuals-lightbox-prev" type="button" data-lightbox-prev aria-label="previous visual">←</button>
      <button class="visuals-lightbox-nav visuals-lightbox-next" type="button" data-lightbox-next aria-label="next visual">→</button>
      <button class="visuals-lightbox-close" type="button" data-lightbox-close aria-label="close viewer">close ✕</button>
    </div>
  </section>

  <script define:vars={{ sources: visualImages, total }}>
    (() => {
      /* ── scroll reveal ── */
      const items = document.querySelectorAll('.visuals-item');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      }

      /* ── lightbox ── */
      const lightbox = document.querySelector('.visuals-lightbox');
      if (!lightbox) return;

      const img = lightbox.querySelector('.visuals-lightbox-img');
      const counter = lightbox.querySelector('.visuals-lightbox-counter');
      const pad = (n) => String(n).padStart(2, '0');
      let current = 0;
      let lastFocused = null;

      const render = (i) => {
        current = (i + total) % total;
        img.src = sources[current];
        img.alt = `visual ${current + 1}`;
        counter.textContent = `${pad(current + 1)} / ${pad(total)}`;
      };

      const open = (i) => {
        lastFocused = document.activeElement;
        render(i);
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        lightbox.querySelector('.visuals-lightbox-close').focus();
      };

      const close = () => {
        lightbox.hidden = true;
        document.body.style.overflow = '';
        if (lastFocused) lastFocused.focus();
      };

      document.querySelectorAll('[data-lightbox-open]').forEach((btn) => {
        btn.addEventListener('click', () => open(Number(btn.dataset.lightboxOpen)));
      });

      lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) =>
        el.addEventListener('click', close)
      );
      lightbox.querySelector('[data-lightbox-prev]').addEventListener('click', () => render(current - 1));
      lightbox.querySelector('[data-lightbox-next]').addEventListener('click', () => render(current + 1));

      document.addEventListener('keydown', (e) => {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') render(current - 1);
        if (e.key === 'ArrowRight') render(current + 1);
      });
    })();
  </script>
</Base>
