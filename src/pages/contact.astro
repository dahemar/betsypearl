---
import Base from '../layouts/Base.astro';
import { getSiteData } from '../lib/cms/getSite';

const { contactEmails } = await getSiteData(Astro.locals);
---

<Base title="contact">
  <section class="simple-page simple-page-contact">
    <ul class="contact-links">
      {contactEmails.map((email) => (
        <li>
          <a href={`mailto:${email}`}>
            <strong>{email}</strong>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
