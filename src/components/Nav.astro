---
import type { NavLink, SiteMeta } from '../data/site';

const {
  currentPath = '/',
  navLinks = [],
  siteMeta = { name: 'betsy pearl', description: '' },
} = Astro.props as {
  currentPath?: string;
  navLinks?: NavLink[];
  siteMeta?: SiteMeta;
};
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/">{siteMeta.name}</a>
    <nav aria-label="main navigation" class="site-nav">
      <ul>
        {navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <li>
              <a href={link.href} class={isActive ? 'is-active' : undefined} aria-current={isActive ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>